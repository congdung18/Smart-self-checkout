{
  "name": "smart-self-checkout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx tools/local.ts",
    "start": "node dist/backend/src/server.js",
    "gateway": "tsx backend/src/gateway-server.ts",
    "build": "prisma generate && tsc -p backend/tsconfig.json && tsc -p tools/tsconfig.json && tsc -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "lint": "eslint backend/src backend/tests frontend/src tools --max-warnings 0",
    "format": "prettier --write backend/src backend/tests frontend tools tests package.json prisma.config.ts compose.yaml .github/workflows/ci.yml docs/Ke_hoach_trien_khai_Smart_Self_Checkout.md docs/05-release.md",
    "format:check": "prettier --check backend/src backend/tests frontend tools tests package.json prisma.config.ts compose.yaml .github/workflows/ci.yml docs/Ke_hoach_trien_khai_Smart_Self_Checkout.md docs/05-release.md",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx backend/src/seed.ts",
    "test": "tsx --test --test-concurrency=1 backend/tests/*.test.ts",
    "test:browser": "node --test tests/app.browser.cjs",
    "test:prototype": "node --test docs/tests/prototype.browser.cjs",
    "docs:index": "node tools/docs-index.mjs",
    "docs:check": "node tools/docs-index.mjs --check",
    "db:tools": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/prepare-pg-tools.ps1",
    "dev:native": "tsx tools/local.ts --native",
    "db:up": "tsx tools/database-cli.ts up",
    "db:stop": "tsx tools/database-cli.ts stop",
    "db:status": "tsx tools/database-cli.ts status",
    "db:adopt-native": "tsx tools/database-cli.ts adopt-native",
    "db:backup": "tsx tools/database-cli.ts backup",
    "db:restore": "tsx tools/database-cli.ts restore",
    "test:docker": "tsx tools/run-suite.ts docker integration",
    "test:native": "tsx tools/run-suite.ts native integration",
    "test:browser:docker": "tsx tools/run-suite.ts docker browser",
    "test:browser:native": "tsx tools/run-suite.ts native browser",
    "typecheck:tools": "tsc -p tools/tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "connect-pg-simple": "10.0.0",
    "express": "5.1.0",
    "express-rate-limit": "8.7.3",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.1",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.5",
    "@types/express-session": "1.18.2",
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/supertest": "6.0.3",
    "@vitejs/plugin-react": "5.1.1",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.3.7"
  }
}
